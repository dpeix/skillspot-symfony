{% extends 'base.html.twig' %}
{% block title %}{{ 'organizer.participants.title'|trans }}{% endblock %}
{% block body %}
{% set translation = session.workshop.translation(app.request.locale) %}
<section class="dashboard-header"><div class="container"><p class="eyebrow">{{ translation.title }}</p><h1>{{ 'organizer.participants.heading'|trans }}</h1><p class="hero-copy">{{ 'organizer.participants.session'|trans({date: session.startsAt|format_datetime(pattern: 'EEEE d MMMM y, HH:mm', timezone: 'Europe/Paris', locale: app.request.locale), status: session.status.labelKey|trans}) }}</p></div></section>
<section class="section" style="padding-top:1rem"><div class="container">
    {% if bookings %}<div class="data-list">{% for booking in bookings %}<div class="data-row"><div><strong>{{ booking.attendee.displayName }}</strong><div class="muted">{{ booking.attendee.email }}</div></div><div><span class="tag">{{ booking.status.labelKey|trans }}</span>{% if booking.attendance.value != 'pending' %}<span class="tag tag-muted">{{ booking.attendance.labelKey|trans }}</span>{% endif %}</div><div class="actions">{% if session.status.value == 'completed' and booking.status.value == 'confirmed' %}<form method="post" action="{{ path('organizer_attendance', {id: booking.id, attendance: 'attended'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('attendance-' ~ booking.id) }}"><button class="button button-small">{{ 'organizer.participants.attended'|trans }}</button></form><form method="post" action="{{ path('organizer_attendance', {id: booking.id, attendance: 'no_show'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('attendance-' ~ booking.id) }}"><button class="button button-danger button-small">{{ 'organizer.participants.no_show'|trans }}</button></form>{% endif %}</div></div>{% endfor %}</div>{% else %}<div class="empty-state"><h3>{{ 'organizer.participants.empty_title'|trans }}</h3><p>{{ 'organizer.participants.empty_text'|trans }}</p></div>{% endif %}
</div></section>
{% endblock %}
