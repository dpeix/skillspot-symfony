{% extends 'base.html.twig' %}
{% block title %}Participants — SkillSpot{% endblock %}
{% block body %}<section class="dashboard-header"><div class="container"><p class="eyebrow">{{ session.workshop.title }}</p><h1>Participants</h1><p class="hero-copy">Session du {{ session.startsAt|date('d/m/Y à H:i', 'Europe/Paris') }} · {{ session.status.value }}</p></div></section><section class="section" style="padding-top:1rem"><div class="container">
    {% if bookings %}<div class="data-list">{% for booking in bookings %}<div class="data-row"><div><strong>{{ booking.attendee.displayName }}</strong><div class="muted">{{ booking.attendee.email }}</div></div><div><span class="tag">{{ booking.status.label }}</span>{% if booking.attendance.value != 'pending' %}<span class="tag tag-muted">{{ booking.attendance.value == 'attended' ? 'Présent' : 'Absent' }}</span>{% endif %}</div><div class="actions">{% if session.status.value == 'completed' and booking.status.value == 'confirmed' %}<form method="post" action="{{ path('organizer_attendance', {id: booking.id, attendance: 'attended'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('attendance-' ~ booking.id) }}"><button class="button button-small">Présent</button></form><form method="post" action="{{ path('organizer_attendance', {id: booking.id, attendance: 'no_show'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('attendance-' ~ booking.id) }}"><button class="button button-danger button-small">Absent</button></form>{% endif %}</div></div>{% endfor %}</div>{% else %}<div class="empty-state"><h3>Aucun participant</h3><p>Les réservations apparaîtront ici.</p></div>{% endif %}
</div></section>{% endblock %}
