{% extends 'base.html.twig' %}
{% block title %}{{ 'organizer.dashboard.title'|trans }}{% endblock %}
{% block body %}
<section class="dashboard-header"><div class="container"><p class="eyebrow">{{ 'organizer.dashboard.eyebrow'|trans }}</p><h1>{{ 'organizer.dashboard.heading'|trans }}</h1><p class="hero-copy">{{ 'organizer.dashboard.intro'|trans }}</p></div></section>
<section class="section" style="padding-top:1rem"><div class="container">
    <div class="stats-grid"><div class="stat"><span class="muted">{{ 'organizer.dashboard.bookings'|trans }}</span><strong>{{ stats.bookings|format_number(locale: app.request.locale) }}</strong></div><div class="stat"><span class="muted">{{ 'organizer.dashboard.confirmed'|trans }}</span><strong>{{ stats.confirmed|format_number(locale: app.request.locale) }}</strong></div><div class="stat"><span class="muted">{{ 'organizer.dashboard.attended'|trans }}</span><strong>{{ stats.attended|format_number(locale: app.request.locale) }}</strong></div><div class="stat"><span class="muted">{{ 'organizer.dashboard.no_show'|trans }}</span><strong>{{ stats.no_show|format_number(locale: app.request.locale) }}</strong></div></div>
    <div class="section-heading"><h2>{{ 'organizer.dashboard.workshops'|trans }}</h2><a class="button" href="{{ path('organizer_workshop_new') }}">{{ 'organizer.dashboard.create'|trans }}</a></div>
    {% if workshops %}<div class="data-list">{% for workshop in workshops %}{% set translation = workshop.translation(app.request.locale) %}<article class="panel"><div class="panel-heading"><div><div class="tag-row"><span class="tag">{{ workshop.status.labelKey|trans }}</span><span class="tag tag-muted">{{ workshop.category.labelKey|trans }}</span></div><h3>{{ translation.title }}</h3></div><div class="actions"><a href="{{ path('organizer_workshop_edit', {id: workshop.id}) }}">{{ 'common.edit'|trans }}</a><a class="button button-secondary button-small" href="{{ path('organizer_session_new', {id: workshop.id}) }}">{{ 'organizer.dashboard.add_session'|trans }}</a>{% if workshop.status.value == 'draft' %}<form method="post" action="{{ path('organizer_workshop_publish', {id: workshop.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('publish-' ~ workshop.id) }}"><button class="button button-small">{{ 'common.publish'|trans }}</button></form>{% endif %}</div></div>
        <div class="data-list">{% for session in workshop.sessions %}<div class="data-row"><div><strong>{{ session.startsAt|format_datetime(pattern: 'EEEE d MMMM y, HH:mm', timezone: 'Europe/Paris', locale: app.request.locale) }}</strong><div class="muted">{{ session.mode.labelKey|trans }} · {{ session.status.labelKey|trans }}</div></div><div>{{ 'organizer.dashboard.confirmed_count'|trans({confirmed: session.confirmedCount, capacity: session.capacity}) }}</div><div class="actions"><a href="{{ path('organizer_session_participants', {id: session.id}) }}">{{ 'organizer.dashboard.participants'|trans }}</a>{% if session.status.value == 'scheduled' %}<form method="post" action="{{ path('organizer_session_cancel', {id: session.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cancel-session-' ~ session.id) }}"><button class="button button-danger button-small">{{ 'common.cancel'|trans }}</button></form>{% endif %}</div></div>{% else %}<p class="muted">{{ 'organizer.dashboard.add_session_help'|trans }}</p>{% endfor %}</div>
    </article>{% endfor %}</div>{% else %}<div class="empty-state"><h3>{{ 'organizer.dashboard.empty_title'|trans }}</h3><p>{{ 'organizer.dashboard.empty_text'|trans }}</p><a class="button" href="{{ path('organizer_workshop_new') }}">{{ 'organizer.dashboard.create'|trans }}</a></div>{% endif %}
</div></section>
{% endblock %}
