{% extends 'base.html.twig' %}
{% block title %}Espace organisateur — SkillSpot{% endblock %}
{% block body %}
<section class="dashboard-header"><div class="container"><p class="eyebrow">Espace organisateur</p><h1>Pilotez vos ateliers</h1><p class="hero-copy">Planning, remplissage, participants et présence en un coup d’œil.</p></div></section>
<section class="section" style="padding-top:1rem"><div class="container">
    <div class="stats-grid"><div class="stat"><span class="muted">Réservations</span><strong>{{ stats.bookings }}</strong></div><div class="stat"><span class="muted">Confirmées</span><strong>{{ stats.confirmed }}</strong></div><div class="stat"><span class="muted">Présents</span><strong>{{ stats.attended }}</strong></div><div class="stat"><span class="muted">Absents</span><strong>{{ stats.no_show }}</strong></div></div>
    <div class="section-heading"><h2>Mes ateliers</h2><a class="button" href="{{ path('organizer_workshop_new') }}">Créer un atelier</a></div>
    {% if workshops %}<div class="data-list">{% for workshop in workshops %}<article class="panel"><div class="panel-heading"><div><div class="tag-row"><span class="tag">{{ workshop.status.value }}</span><span class="tag tag-muted">{{ workshop.category.label }}</span></div><h3>{{ workshop.title }}</h3></div><div class="actions"><a href="{{ path('organizer_workshop_edit', {id: workshop.id}) }}">Modifier</a><a class="button button-secondary button-small" href="{{ path('organizer_session_new', {id: workshop.id}) }}">Ajouter une session</a>{% if workshop.status.value == 'draft' %}<form method="post" action="{{ path('organizer_workshop_publish', {id: workshop.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('publish-' ~ workshop.id) }}"><button class="button button-small">Publier</button></form>{% endif %}</div></div>
        <div class="data-list">{% for session in workshop.sessions %}<div class="data-row"><div><strong>{{ session.startsAt|date('d/m/Y à H:i', 'Europe/Paris') }}</strong><div class="muted">{{ session.mode.label }} · {{ session.status.value }}</div></div><div>{{ session.confirmedCount }} / {{ session.capacity }} confirmés</div><div class="actions"><a href="{{ path('organizer_session_participants', {id: session.id}) }}">Participants</a>{% if session.status.value == 'scheduled' %}<form method="post" action="{{ path('organizer_session_cancel', {id: session.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cancel-session-' ~ session.id) }}"><button class="button button-danger button-small">Annuler</button></form>{% endif %}</div></div>{% else %}<p class="muted">Ajoutez une session pour pouvoir publier.</p>{% endfor %}</div>
    </article>{% endfor %}</div>{% else %}<div class="empty-state"><h3>Créez votre premier atelier</h3><p>Commencez par présenter le sujet et le niveau attendu.</p><a class="button" href="{{ path('organizer_workshop_new') }}">Créer un atelier</a></div>{% endif %}
</div></section>
{% endblock %}
