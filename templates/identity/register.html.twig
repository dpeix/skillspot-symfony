{% extends 'base.html.twig' %}
{% block title %}{{ 'identity.register.title'|trans }}{% endblock %}
{% block body %}<section class="auth-shell"><div class="auth-card"><p class="eyebrow">{{ 'identity.register.eyebrow'|trans }}</p><h1>{{ 'identity.register.heading'|trans }}</h1>{{ form_start(form) }}{{ form_widget(form) }}<button class="button" type="submit">{{ 'identity.register.submit'|trans }}</button>{{ form_end(form) }}<p class="muted" style="margin-top:1rem">{{ 'identity.register.already_member'|trans }} <a href="{{ path('app_login') }}">{{ 'identity.register.login'|trans }}</a></p></div></section>{% endblock %}
