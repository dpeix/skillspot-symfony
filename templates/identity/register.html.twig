{% block title %}Créer un compte — SkillSpot{% endblock %}
{% block body %}<section class="auth-shell"><div class="auth-card"><p class="eyebrow">Rejoignez la communauté</p><h1>Créer un compte</h1>{{ form_start(form) }}{{ form_widget(form) }}<button class="button" type="submit">Créer mon compte</button>{{ form_end(form) }}<p class="muted" style="margin-top:1rem">Déjà membre ? <a href="{{ path('app_login') }}">Se connecter</a></p></div></section>{% endblock %}
