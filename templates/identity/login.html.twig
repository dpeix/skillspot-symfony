{% extends 'base.html.twig' %}
{% block title %}{{ 'identity.login.title'|trans }}{% endblock %}
{% block body %}<section class="auth-shell"><div class="auth-card"><p class="eyebrow">{{ 'identity.login.eyebrow'|trans }}</p><h1>{{ 'identity.login.heading'|trans }}</h1>
    {% if error %}<div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
    <form method="post"><div class="form-row"><label for="email">{{ 'identity.form.email'|trans }}</label><input class="form-control" type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus></div><div class="form-row"><label for="password">{{ 'identity.form.password'|trans }}</label><input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required></div><div class="form-row"><label><input type="checkbox" name="_remember_me"> {{ 'identity.login.remember'|trans }}</label></div><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="button" type="submit">{{ 'identity.login.submit'|trans }}</button></form>
    <p style="margin-top:1.5rem"><a href="{{ path('forgot_password_request') }}">{{ 'identity.login.forgot'|trans }}</a></p><p class="muted">{{ 'identity.login.no_account'|trans }} <a href="{{ path('register') }}">{{ 'identity.login.register'|trans }}</a></p>
</div></section>{% endblock %}
