{% extends 'base.html.twig' %}
{% block title %}{{ 'admin.organizer_application.title'|trans }}{% endblock %}
{% block body %}<section class="dashboard-header"><div class="container"><p class="eyebrow">{{ 'admin.organizer_application.eyebrow'|trans }}</p><h1>{{ 'admin.organizer_application.heading'|trans }}</h1></div></section><section class="section" style="padding-top:1rem"><div class="container">
    {% if applications %}<div class="data-list">{% for application in applications %}<article class="panel"><div class="panel-heading"><div><h3>{{ application.applicant.displayName }}</h3><p class="muted">{{ application.applicant.email }} · {{ application.createdAt|format_date(pattern: 'd MMMM y', locale: app.request.locale) }}</p></div></div><p class="prose">{{ application.motivation }}</p><form method="post" action="{{ path('admin_organizer_application_review', {id: application.id, decision: 'approve'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('review-' ~ application.id) }}"><div class="form-row"><label for="note-{{ application.id }}">{{ 'admin.organizer_application.note'|trans }}</label><textarea class="form-control" id="note-{{ application.id }}" name="note" rows="3"></textarea></div><div class="actions"><button class="button" type="submit">{{ 'admin.organizer_application.approve'|trans }}</button><button class="button button-danger" type="submit" formaction="{{ path('admin_organizer_application_review', {id: application.id, decision: 'reject'}) }}">{{ 'admin.organizer_application.reject'|trans }}</button></div></form></article>{% endfor %}</div>{% else %}<div class="empty-state"><h3>{{ 'admin.organizer_application.empty_title'|trans }}</h3><p>{{ 'admin.organizer_application.empty_text'|trans }}</p></div>{% endif %}
</div></section>{% endblock %}
