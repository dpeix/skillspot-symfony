{% extends 'base.html.twig' %}
{% block title %}Demandes organisateur — SkillSpot{% endblock %}
{% block body %}<section class="dashboard-header"><div class="container"><p class="eyebrow">Administration</p><h1>Demandes organisateur</h1></div></section><section class="section" style="padding-top:1rem"><div class="container">
    {% if applications %}<div class="data-list">{% for application in applications %}<article class="panel"><div class="panel-heading"><div><h3>{{ application.applicant.displayName }}</h3><p class="muted">{{ application.applicant.email }} · {{ application.createdAt|date('d/m/Y') }}</p></div></div><p class="prose">{{ application.motivation }}</p><form method="post" action="{{ path('admin_organizer_application_review', {id: application.id, decision: 'approve'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('review-' ~ application.id) }}"><div class="form-row"><label for="note-{{ application.id }}">Note interne ou retour</label><textarea class="form-control" id="note-{{ application.id }}" name="note" rows="3"></textarea></div><div class="actions"><button class="button" type="submit">Accepter</button><button class="button button-danger" type="submit" formaction="{{ path('admin_organizer_application_review', {id: application.id, decision: 'reject'}) }}">Refuser</button></div></form></article>{% endfor %}</div>{% else %}<div class="empty-state"><h3>Tout est traité</h3><p>Aucune demande en attente.</p></div>{% endif %}
</div></section>{% endblock %}
