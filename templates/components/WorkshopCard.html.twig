{% set nextSession = workshop.sessions|first %}
{% set translation = workshop.translation(app.request.locale) %}
<article class="workshop-card">
    <a href="{{ path('workshop_show', {slug: translation.slug}) }}" class="card-link">
        <div class="card-accent card-accent-{{ workshop.category.value }}"></div>
        <div class="card-body">
            <div class="tag-row">
                <span class="tag">{{ workshop.category.labelKey|trans }}</span>
                <span class="tag tag-muted">{{ workshop.level.labelKey|trans }}</span>
            </div>
            <h3>{{ translation.title }}</h3>
            <p>{{ translation.description|length > 125 ? translation.description|slice(0, 125) ~ '…' : translation.description }}</p>
            {% if nextSession %}
                <div class="card-meta">
                    <strong>{{ nextSession.startsAt|format_datetime(pattern: 'd MMM', timezone: 'Europe/Paris', locale: app.request.locale) }}</strong>
                    <span>{{ nextSession.mode.labelKey|trans }}</span>
                </div>
            {% endif %}
        </div>
    </a>
</article>
