{% extends 'base.html.twig' %}

{% block title %}SkillSpot — Apprenez, partagez, rencontrez{% endblock %}

{% block body %}
<section class="hero">
    <div class="container hero-grid">
        <div>
            <p class="eyebrow">Des savoirs qui circulent</p>
            <h1>Apprenez quelque chose de <span>concret.</span></h1>
            <p class="hero-copy">Découvrez des ateliers en petit groupe, animés par des professionnels passionnés. Réservez en quelques secondes, sur place ou à distance.</p>
            <div class="hero-actions">
                <a class="button" href="{{ path('workshop_catalog') }}">Explorer les ateliers</a>
                {% if not app.user %}<a class="button button-secondary" href="{{ path('register') }}">Rejoindre SkillSpot</a>{% endif %}
            </div>
        </div>
        <div class="hero-panel" aria-hidden="true">
            <div class="floating-card"><div class="mini-icon">⌘</div><h3>Symfony sans magie noire</h3><p class="muted">Développement · Intermédiaire</p></div>
            <div class="floating-card"><div class="mini-icon">✦</div><h3>Design critique en équipe</h3><p class="muted">Design · Débutant</p></div>
            <div class="floating-card"><strong>94%</strong><p class="muted">de participants présents</p></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Prochainement</p><h2>Ateliers à découvrir</h2></div><a href="{{ path('workshop_catalog') }}">Voir tout →</a></div>
        {% if workshops %}
            <div class="workshop-grid">{% for workshop in workshops %}<twig:WorkshopCard :workshop="workshop" />{% endfor %}</div>
        {% else %}
            <div class="empty-state"><h3>La programmation arrive</h3><p>Chargez les fixtures de démonstration pour découvrir SkillSpot.</p></div>
        {% endif %}
    </div>
</section>

<section class="section section-soft">
    <div class="container detail-grid">
        <div><p class="eyebrow">Partagez votre expertise</p><h2>Vous avez quelque chose à transmettre ?</h2><p class="hero-copy">Proposez votre projet. Notre équipe valide votre profil, puis vous gardez la main sur vos ateliers, vos sessions et vos participants.</p></div>
        <div class="panel"><h3>Un espace organisateur complet</h3><p class="muted">Planning, capacité, liste d’attente automatique, émargement et statistiques.</p><a class="button" href="{{ app.user ? path('organizer_apply') : path('register') }}">Devenir organisateur</a></div>
    </div>
</section>
{% endblock %}
