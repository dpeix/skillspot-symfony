{% extends 'base.html.twig' %}
{% set translation = workshop.translation(app.request.locale) %}
{% block title %}{{ translation.title }} — SkillSpot{% endblock %}
{% block body %}
<section class="dashboard-header"><div class="container"><div class="tag-row"><span class="tag">{{ workshop.category.labelKey|trans }}</span><span class="tag tag-muted">{{ workshop.level.labelKey|trans }}</span></div><h1>{{ translation.title }}</h1><p class="muted">{{ 'workshop.hosted_by'|trans({name: workshop.owner.displayName}) }}</p></div></section>
<section class="section" style="padding-top:1rem"><div class="container detail-grid">
    <article class="panel"><h2>{{ 'workshop.about'|trans }}</h2><div class="prose">{{ translation.description }}</div></article>
    <aside><div class="panel"><div class="panel-heading"><div><p class="eyebrow">{{ 'workshop.sessions'|trans }}</p><h2 style="font-size:1.7rem">{{ 'workshop.choose_date'|trans }}</h2></div></div>
        <div class="session-list">
        {% for session in workshop.sessions %}
            {% if session.status.value == 'scheduled' and session.startsAt > date() %}
            <div class="session-card" data-controller="availability" data-availability-url-value="{{ mercure('/sessions/' ~ session.id ~ '/availability') }}" data-availability-available-label-value="{{ 'workshop.availability.available'|trans }}" data-availability-waitlist-label-value="{{ 'workshop.availability.waitlist'|trans }}">
                <div class="session-top"><div><strong>{{ session.startsAt|format_datetime(pattern: 'EEEE d MMMM y, HH:mm', timezone: 'Europe/Paris', locale: app.request.locale) }}</strong><div class="muted">{{ session.mode.labelKey|trans }} · {{ session.endsAt|format_datetime(pattern: 'HH:mm', timezone: 'Europe/Paris', locale: app.request.locale) }}</div></div><span class="tag">{{ 'common.places'|trans({count: session.capacity}) }}</span></div>
                <p class="availability"><span data-availability-target="count">{{ session.remainingSeats }}</span> <span data-availability-target="label">{{ (session.remainingSeats > 0 ? 'workshop.availability.available' : 'workshop.availability.waitlist')|trans }}</span></p>
                {% if app.user %}
                    <form method="post" action="{{ path('booking_create', {id: session.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('book-' ~ session.id) }}"><button class="button button-small" type="submit">{{ (session.remainingSeats > 0 ? 'workshop.book' : 'workshop.join_waitlist')|trans }}</button></form>
                {% else %}
                    <a class="button button-small" href="{{ path('app_login') }}">{{ 'workshop.login_to_book'|trans }}</a>
                {% endif %}
            </div>
            {% endif %}
        {% else %}<p class="muted">{{ 'workshop.no_session'|trans }}</p>{% endfor %}
        </div>
    </div></aside>
</div></section>
{% endblock %}
