<!doctype html>
<html lang="{{ locale }}">
<body style="margin:0;background:#f5f3ff;font-family:Arial,sans-serif;color:#1f1b2d">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr><td align="center" style="padding:32px 16px">
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;background:#fff;border-radius:18px;overflow:hidden">
                <tr><td style="padding:24px 32px;background:#4f46e5;color:#fff;font-size:24px;font-weight:700">SkillSpot</td></tr>
                <tr><td style="padding:32px">
                    <p>{{ 'email.greeting'|trans({name: recipientName}, locale: locale) }}</p>
                    <h1 style="font-size:26px">{{ heading }}</h1>
                    <p style="line-height:1.6">{{ body }}</p>
                    {% if actionUrl %}
                        <p style="margin-top:28px"><a href="{{ actionUrl }}" style="background:#4f46e5;color:#fff;text-decoration:none;padding:12px 20px;border-radius:10px">{{ actionLabel }}</a></p>
                    {% endif %}
                    <p style="margin-top:32px;color:#68647a;font-size:13px">{{ 'email.footer'|trans(locale: locale) }}</p>
                </td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
