{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="form-row{% if errors|length > 0 %} has-error{% endif %}">
        {{ form_label(form) }}
        {{ form_widget(form, {attr: (attr|default({}))|merge({class: ((attr.class|default('')) ~ ' form-control')|trim})}) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}
