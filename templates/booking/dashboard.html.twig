{% extends 'base.html.twig' %}
{% block title %}{{ 'booking.dashboard.title'|trans }}{% endblock %}
{% block body %}
<section class="dashboard-header"><div class="container"><p class="eyebrow">{{ 'booking.dashboard.eyebrow'|trans }}</p><h1>{{ 'booking.dashboard.hello'|trans({name: app.user.firstName}) }}</h1><p class="hero-copy">{{ 'booking.dashboard.intro'|trans }}</p></div></section>
<section class="section" style="padding-top:1rem"><div class="container">
    <div class="section-heading"><h2>{{ 'booking.dashboard.heading'|trans }}</h2><a class="button button-secondary" href="{{ path('workshop_catalog') }}">{{ 'booking.dashboard.discover'|trans }}</a></div>
    {% if bookings %}<div class="data-list">
        {% for booking in bookings %}
            {% set workshopTranslation = booking.session.workshop.translation(app.request.locale) %}
            <article class="data-row">
                <div><div class="tag-row"><span class="tag {{ booking.status.value == 'cancelled' ? 'tag-danger' : (booking.status.value == 'confirmed' ? 'tag-success' : '') }}">{{ booking.status.labelKey|trans }}</span></div><h3><a href="{{ path('workshop_show', {slug: workshopTranslation.slug}) }}">{{ workshopTranslation.title }}</a></h3><span class="muted">{{ booking.session.mode.labelKey|trans }}</span>{% if booking.status.value == 'confirmed' and booking.session.mode.value == 'online' and booking.session.meetingUrl %}<div><a href="{{ booking.session.meetingUrl }}" rel="noopener noreferrer">{{ 'booking.dashboard.video_link'|trans }}</a></div>{% endif %}</div>
                <div><strong>{{ booking.session.startsAt|format_datetime(pattern: 'EEEE d MMMM y, HH:mm', timezone: 'Europe/Paris', locale: app.request.locale) }}</strong><div class="muted">{{ 'booking.dashboard.ends_at'|trans({time: booking.session.endsAt|format_datetime(pattern: 'HH:mm', timezone: 'Europe/Paris', locale: app.request.locale)}) }}</div></div>
                <div class="actions">{% if booking.status.value != 'cancelled' and booking.session.startsAt > date('+24 hours') %}<form method="post" action="{{ path('booking_cancel', {id: booking.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cancel-booking-' ~ booking.id) }}"><button class="button button-danger button-small">{{ 'common.cancel'|trans }}</button></form>{% endif %}</div>
            </article>
        {% endfor %}
    </div>{% else %}<div class="empty-state"><h3>{{ 'booking.dashboard.empty_title'|trans }}</h3><p>{{ 'booking.dashboard.empty_text'|trans }}</p><a class="button" href="{{ path('workshop_catalog') }}">{{ 'booking.dashboard.explore'|trans }}</a></div>{% endif %}
    {% if not is_granted('ROLE_ORGANIZER') %}<div class="panel" style="margin-top:2rem"><div class="panel-heading"><div><p class="eyebrow">{{ 'booking.dashboard.share_eyebrow'|trans }}</p><h3>{{ 'booking.dashboard.share_title'|trans }}</h3></div><a class="button button-secondary" href="{{ path('organizer_apply') }}">{{ 'booking.dashboard.become_organizer'|trans }}</a></div></div>{% endif %}
</div></section>
{% endblock %}
